<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.app.bricksbreaker.GamePanel
        android:id="@+id/gameSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <Button
        android:id="@+id/pause"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@color/main"
        android:text="@string/esc"
        android:textColor="#212121" />

    <Button
        android:id="@+id/restart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/main"
        android:layout_margin="10dp"
        android:layout_centerInParent="true"
        android:text="@string/restart"
        android:textColor="#212121"
        android:visibility="visible" />

    <EditText
        android:id="@+id/difficulty_input"
        android:layout_width="107dp"
        android:layout_height="52dp"
        android:layout_above="@id/restart"
        android:layout_centerInParent="true"
        android:background="@color/main"
        android:layout_margin="10dp"
        android:hint="@string/difficulty"
        android:importantForAutofill="no"
        android:inputType="number"
        android:text="2"
        android:visibility="visible" />

    <TextView
        android:id="@+id/status_output"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/main"
        android:layout_margin="10dp"
        android:textSize="25sp"
        android:layout_centerInParent="true"
        android:layout_above="@id/difficulty_input"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/main"
        android:layout_margin="10dp"
        android:layout_centerInParent="true"
        android:layout_below="@id/restart"
        android:visibility="gone" />

</RelativeLayout>